# Copy to .env for local development. On Cloud Run set these as service env vars.
GOOGLE_CLOUD_PROJECT=hackucd-511208
GCS_BUCKET=hackucd-storage
MAX_UPLOAD_MB=128
# CORS_ORIGIN=http://localhost:5173
# Local only: credentials that act as hackucd-backend@hackucd-511208.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/hackucd-adc.json
# OPENROUTER_API_KEY=sk-or-...
TRANSCRIBE_TIMEOUT_SECONDS=240
# Stripe sandbox (test mode) secret key: Stripe Dashboard > Developers > API keys. Use sk_test_ only.
# STRIPE_SECRET_KEY=sk_test_...
# Where Stripe sends users back after checkout (the deployed frontend). Defaults to the calling page's origin.
# FRONTEND_URL=http://localhost:5173
